// Escribe .env.local con la URL y la clave publicable del Supabase local: `npm run env:local`.
// Solo van valores públicos; la clave secreta se queda en la CLI de Supabase.
// No sobrescribe un .env.local distinto salvo con --force.
import { existsSync, readFileSync, writeFileSync } from "node:fs";

import { readLocalSupabase } from "./lib/supabase-local.mts";

const FILE = ".env.local";

function main(): void {
  const { url, publishableKey } = readLocalSupabase();
  const content = [
    "# Generated by `npm run env:local` from the local Supabase (npm run db:up).",
    `NEXT_PUBLIC_SUPABASE_URL=${url}`,
    `NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=${publishableKey}`,
    "",
  ].join("\n");

  if (existsSync(FILE)) {
    if (readFileSync(FILE, "utf8") === content) {
      console.log(`${FILE} ya apunta al Supabase local.`);
      return;
    }
    if (!process.argv.includes("--force")) {
      throw new Error(
        `${FILE} ya existe con otros valores. Revísalo o ejecuta: npm run env:local -- --force`,
      );
    }
  }

  writeFileSync(FILE, content);
  console.log(`${FILE} escrito: ${url}`);
}

try {
  main();
} catch (error) {
  console.error(error instanceof Error ? error.message : String(error));
  process.exitCode = 1;
}
